      "enrichment": {
        "cited_by_count": 242679,
        "reference_count": 54,
        "mag_id": "2949650786",
        "publication_type": "conference",
        "venue": "Computer Vision and Pattern Recognition",
        "publication_date": "Dec 10, 2015",
        "fields_of_study": [
